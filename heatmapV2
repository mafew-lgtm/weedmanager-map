# ==========================================
# 4. GITHUB UPLOAD FUNCTION (WITH RETRIES)
# ==========================================
def upload_to_github(local_file_path, repo_file_path, commit_message, max_retries=3):
    url = f"https://api.github.com/repos/{GITHUB_REPO}/contents/{repo_file_path}"
    headers = {
        "Authorization": f"Bearer {GITHUB_TOKEN}",
        "Accept": "application/vnd.github+json",
    }

    with open(local_file_path, "rb") as f:
        content_encoded = base64.b64encode(f.read()).decode("utf-8")

    response = requests.get(url, headers=headers, params={"ref": BRANCH})
    sha = response.json().get("sha") if response.status_code == 200 else None

    payload = {
        "message": commit_message,
        "content": content_encoded,
        "branch": BRANCH,
    }
    if sha:
        payload["sha"] = sha

    for attempt in range(1, max_retries + 1):
        put_response = requests.put(url, json=payload, headers=headers)
        if put_response.status_code in [200, 201]:
            print(f" -> Successfully uploaded {repo_file_path} to GitHub!")
            return True
        print(f" -> Attempt {attempt} for {repo_file_path} failed: {put_response.status_code} - {put_response.text}")

    return False

print("\n----------------------------------------")
print("Uploading files to GitHub repository...")
print("----------------------------------------")

# Upload static site HTML files
upload_to_github(WEBMAP_FILE, "index.html", "Update map frame with fetch-based GeoJSON loading")
upload_to_github(DASHBOARD_FILE, "dashboard.html", "Upload Dashboard")

# Upload exported GeoJSON files individually
for filename, _ in exported_geojson_files:
    local_path = os.path.join(OUTPUT_FOLDER, filename)
    upload_to_github(local_path, filename, f"Update layer data: {filename}")
